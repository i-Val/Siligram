{
    "name": "i-val/siligram-bot",
    "description": "Lightweight, fluent Laravel Telegram Bot API client and webhook handler with zero external HTTP dependencies.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "i-val"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "IVal\\SiligramBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IVal\\SiligramBot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IVal\\SiligramBot\\TelegramServiceProvider"
            ],
            "aliases": {
                "Telegram": "IVal\\SiligramBot\\Facades\\Telegram"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
